<Window x:Class="Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="開發初始設定"
        Width="480"
        MinHeight="680"
        MaxHeight="1000"
        SizeToContent="Height"
        Loaded="OnWindowLoaded"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#0A84FF" />
            <Setter Property="Padding" Value="26,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#1C1C1E" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Padding" Value="26,12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D1D6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border CornerRadius="18"
                Background="#F2F2F2"
                BorderBrush="#D1D1D6"
                BorderThickness="1"
                PreviewMouseLeftButtonDown="OnWindowMouseDown">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,24,36,16">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" Background="Transparent">
                        <Button Width="12"
                                Height="12"
                                Background="#FF5F57"
                                BorderBrush="#E0443E"
                                BorderThickness="1"
                                Padding="0"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="OnCloseClick"
                                Margin="0,0,6,0" />
                        <Button Width="12"
                                Height="12"
                                Background="#FFBD2E"
                                BorderBrush="#D9A423"
                                BorderThickness="1"
                                Padding="0"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="OnMinimizeClick"
                                Margin="0,0,6,0" />
                        <Button Width="12"
                                Height="12"
                                Background="#28C840"
                                BorderBrush="#1FA233"
                                BorderThickness="1"
                                Padding="0"
                                Style="{StaticResource WindowControlButtonStyle}"
                                Click="OnMaximizeClick" />
                    </StackPanel>

					<TextBlock Text="2026年PC曝光自動化"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1C1C1E"
                               HorizontalAlignment="Center"
                               Margin="24,0,24,16" />

                    <Border Background="White"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,0,0,16"
                            BorderThickness="1"
                            BorderBrush="#ECECEC">
                        <StackPanel>
                            <TextBlock Text="搜尋排名"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            
                            <StackPanel Orientation="Horizontal" Width="309">
                                <TextBlock Text="最大頁數"
                                           FontSize="13"
                                           Foreground="#6E6E73"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <ComboBox x:Name="MaxPagesCombo"
                                          Height="32"
                                          MinWidth="120"
                                          Padding="8,4"
                                          Background="White"
                                          BorderBrush="#D1D1D6"
                                          BorderThickness="1"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White"
                            CornerRadius="16"
                            Padding="16"
                            Margin="0,0,0,16"
                            BorderThickness="1"
                            BorderBrush="#ECECEC">
                        <StackPanel>
							<TextBlock
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" Text="紀錄設定" />
							<StackPanel Orientation="Horizontal" Margin="0,0,0,8" Width="260">
                                <TextBlock Text="運行"
                                           FontSize="13"
                                           Foreground="#6E6E73"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />
                                <ComboBox x:Name="ProgressEveryCombo"
                                          Height="32"
                                          MinWidth="120"
                                          Padding="8,4"
                                          Background="White"
                                          BorderBrush="#D1D1D6"
                                          BorderThickness="1"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Text="筆 紀錄一次"
                                           FontSize="13"
                                           Foreground="#6E6E73"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="StatusText"
                                       Text="尚未開始"
                                       FontSize="13"
                                       Foreground="#6E6E73"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="ProgressText"
                                       Text="進度：尚未開始"
                                       FontSize="13"
                                       Foreground="#6E6E73"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="AutoStartupCheckBox"
                              Content="啟動時自動更新PC連結、排名與標題"
                              FontSize="16"
                              Margin="0,4,0,0"
                              Foreground="#1C1C1E"
                              Checked="OnAutoStartupCheckedChanged"
                              Unchecked="OnAutoStartupCheckedChanged" />

					<StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,24,0,16">
						<Button Content="更新銷量"
                                Style="{StaticResource PrimaryButtonStyle}"
                                FontSize="16"
                                Padding="22,10"
                                Margin="0,0,12,0"
                                Click="OnUpdateSalesClick" />
						<Button Content="取消"
                                Style="{StaticResource SecondaryButtonStyle}"
                                FontSize="16"
                                Padding="22,10"
                                Click="OnCancelClick" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
